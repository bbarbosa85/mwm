#!/usr/bin/env python3
"""Builds docs/examples.html and docs/examples/mwm-examples.zip from docs/examples/*.mwm.yml.

Run after adding or changing an example:  script/build-examples-page
The plain-language lists below are written by hand: keep them in step with the files.
"""
import html, os, zipfile

root = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "docs")
ex = os.path.join(root, "examples")
import subprocess
_VERSION = subprocess.check_output(["/usr/libexec/PlistBuddy", "-c", "Print :CFBundleShortVersionString",
                                    os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "MWM", "App", "MWM-Info.plist")], text=True).strip()
DMG = f"https://github.com/bbarbosa85/mwm/raw/master/docs/downloads/MWM-{_VERSION}.dmg"
BLUE, SUN, CORAL, WHITE = "#1f5bff", "#ffd21f", "#ff5a5f", "#ffffff"


def screen(tiles, w=240, h=150, x0=0, y0=0):
    """A little picture of a screen. tiles: (x, y, w, h, color) in percent of the screen."""
    pad, top = 6, 12
    aw, ah = w - 2 * pad, h - top - pad
    out = [f'<rect x="{x0 + 1}" y="{y0 + 1}" width="{w - 2}" height="{h - 2}" rx="9" fill="#33318f" stroke="rgba(255,255,255,.3)" stroke-width="2"/>',
           f'<rect x="{x0 + 1}" y="{y0 + 1}" width="{w - 2}" height="9" rx="4.5" fill="rgba(0,0,0,.3)"/>']
    for (x, y, tw, th, c) in tiles:
        out.append(f'<rect x="{x0 + pad + x / 100 * aw:.1f}" y="{y0 + top + y / 100 * ah:.1f}" width="{tw / 100 * aw - 3:.1f}" height="{th / 100 * ah - 3:.1f}" rx="4" fill="{c}"/>')
    return "".join(out)


def svg(w, h, body):
    return f'<svg viewBox="0 0 {w} {h}" role="img" aria-hidden="true">{body}</svg>'


def label(x, y, text):
    return f'<text x="{x}" y="{y}" text-anchor="middle" font-size="13" font-weight="700" fill="currentColor" font-family="-apple-system, sans-serif">{text}</text>'


def apps_grid():
    cells = []
    for i, (k, c) in enumerate([("F", BLUE), ("S", "#1e7bf0"), ("C", CORAL), ("T", "#4a4d5c"), ("N", SUN), ("M", "#28a745"), ("A", "#e0457b"), ("K", "#6b3fd1")]):
        x, y = 12 + (i % 4) * 56, 14 + (i // 4) * 56
        cells.append(f'<rect x="{x}" y="{y}" width="48" height="48" rx="12" fill="{c}"/><text x="{x + 24}" y="{y + 32}" text-anchor="middle" font-size="22" font-weight="800" fill="{"#222" if c == SUN else "#fff"}" font-family="-apple-system, sans-serif">{k}</text>')
    return svg(240, 126, "".join(cells))


# (file, title, best for, picture, what to change, [(keys, what it does)])
examples = [
    ("starter.mwm.yml", "Starter", "Anyone new to MWM",
     svg(240, 150, screen([(0, 0, 50, 100, WHITE), (50, 0, 50, 50, SUN), (50, 50, 50, 50, CORAL)])),
     "Change Finder, Safari and Terminal to the apps you use.",
     [("⌃⌥⌘ ← →", "Left half, right half"), ("⌃⌥⌘ ↑", "Full screen"), ("⌃⌥⌘ 1 2 3", "Left, middle and right third"),
      ("⌥⇧ F S T", "Jump to Finder, Safari, Terminal"), ("⌘⇧ H", "Show a letter on every window, to jump to it"),
      ("⌃⌥⌘ S · W", "Save your desktop as \"work\", and bring it back")]),
    ("ultrawide.mwm.yml", "Ultrawide", "One very wide monitor",
     svg(420, 112, screen([(0, 0, 34, 100, WHITE), (34, 0, 33, 100, SUN), (67, 0, 33, 100, CORAL)], w=420, h=112)),
     "Nothing needed. It works on any screen, but shines on wide ones.",
     [("⌃⌥⌘ 1 2 3", "Left, middle and right third"), ("⌃⌥⌘ 4 · 6", "Left two thirds, right two thirds"), ("⌃⌥⌘ 5", "Centered, two thirds wide"),
      ("⌃⌥⌘ 9", "A narrow column in the middle, for reading"), ("⌃⌥⌘ 0", "Full screen"), ("⇧⌃⌥⌘ 1 2 3 4", "The four quarters"), ("⌘⇧ H", "Window hints")]),
    ("two-displays.mwm.yml", "Laptop and external display", "Two screens",
     svg(300, 150, screen([(0, 0, 50, 100, WHITE), (50, 0, 50, 100, SUN)], w=110, h=84, x0=4, y0=28)
         + screen([(0, 0, 50, 100, CORAL), (50, 0, 50, 100, "#7fb0ff")], w=170, h=110, x0=124, y0=10)
         + label(59, 20, "laptop") + label(209, 136, "desk")),
     "Name your two screens in <b>Displays</b>, or change <code>Studio Display</code> in the file to your monitor's name.",
     [("⌃⌥⌘ 1 · 2", "Fill the laptop, or fill the desk screen"), ("⌃⌥⌘ Tab", "Send the window to the other screen"),
      ("⌃⌥⌘ arrows", "Halves of the desk screen"), ("⇧⌃⌥⌘ ← →", "Halves of the laptop screen"),
      ("⌃⌥⌘ D · R", "Save your desk setup, and bring it back after plugging in")]),
    ("apps-and-snapshots.mwm.yml", "Apps and snapshots", "Switching between apps and layouts",
     apps_grid(),
     "Change the ten app names to your own. Snapshots start empty: arrange your windows, then press the save shortcut.",
     [("⌥⇧ + a letter", "Jump to Finder, Safari, Chrome, Terminal, Notes, Mail, Calendar, Spotify, VS Code or Slack"),
      ("⌃⌥⌘ W · M · F", "Bring back your \"work\", \"meeting\" or \"focus\" desktop"),
      ("⇧⌃⌥⌘ W · M · F", "Save the desktop you have now as work, meeting or focus")]),
    ("daily-driver.mwm.yml", "The author's daily setup", "A real, lived-in setup",
     svg(420, 120, screen([(0, 0, 25, 100, WHITE), (25, 0, 50, 100, SUN), (75, 0, 25, 100, CORAL)], w=300, h=84, x0=4, y0=6)
         + screen([(0, 0, 100, 100, "#7fb0ff")], w=96, h=66, x0=318, y0=24)),
     "Rename the apps and screens to yours. It uses a MacBook and a 5120×1440 ultrawide.",
     [("⌃⌥⌘ number row and keypad", "Halves, thirds and quarters, on either screen"), ("⌥⇧ + a letter", "Jump to the apps the author uses every day"),
      ("⌘⇧ H", "Window hints"), ("⌃⌥⌘ and ⇧⌃⌥⌘", "Save and restore snapshots"), ("Lots of shortcuts", "The most complete example. A good one to read through and borrow from.")]),
]

with zipfile.ZipFile(os.path.join(ex, "mwm-examples.zip"), "w", zipfile.ZIP_DEFLATED) as z:
    for name, *_ in examples:
        z.write(os.path.join(ex, name), name)


def card(name, title, who, picture, change, rows):
    text = open(os.path.join(ex, name), encoding="utf-8").read()
    n = text.count("\n  - ")
    items = "".join(f'<li><span class="k">{html.escape(k)}</span><span>{html.escape(v)}</span></li>' for k, v in rows)
    return f"""
    <article class="ex" id="{name.split('.')[0]}">
      <div class="head">
        <h2>{html.escape(title)}</h2>
        <p class="who">{html.escape(who)} · {n} shortcuts</p>
      </div>
      <div class="art">{picture}</div>
      <div class="body">
        <ul class="does">{items}</ul>
        <p class="change"><b>Before you use it:</b> {change}</p>
        <div class="acts">
          <a class="btn primary small" href="examples/{name}" download>Download</a>
          <button class="btn small" type="button" data-copy="{name}">Copy the file</button>
        </div>
      </div>
      <details><summary>See the file</summary><pre id="pre-{name}"><code>{html.escape(text)}</code></pre></details>
    </article>"""


page = f"""<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>MWM examples</title>
<meta name="description" content="Ready-made MWM setups you can download: starter, ultrawide, two displays, apps and snapshots.">
<link rel="icon" href="assets/icon.png">
<link rel="stylesheet" href="assets/site.css">
<link rel="stylesheet" href="assets/docs.css">
<style>
  .ex, .how {{ scroll-margin-top: 90px; }}
  .how {{ margin-bottom: 56px; }}
  .how h2 {{ margin: 0 0 14px; font-size: 20px; }}
  .how ol {{ list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; counter-reset: q; }}
  .how li {{ counter-increment: q; display: grid; grid-template-columns: 30px 1fr; gap: 12px; align-items: start; }}
  .how li::before {{ content: counter(q); width: 28px; height: 28px; border-radius: 50%; display: grid; place-items: center; font-weight: 700; font-size: 13px; color: #fff; background: #1f5bff; }}
  .how li p {{ margin: 0; }} .how li .sub {{ color: var(--muted); font-size: 15px; margin-top: 4px; }}
  .how pre {{ margin: 8px 0 0; }}
  .ex {{ display: grid; grid-template-columns: 300px minmax(0, 1fr); gap: 20px 28px; background: var(--surface); border-radius: 14px; padding: 24px; margin-top: 40px; align-items: start; }}
  .ex .art {{ background: var(--surface-2); border-radius: 14px; padding: 18px; color: var(--fg); }}
  .ex .art svg {{ display: block; width: 100%; height: auto; }}
  .ex .body {{ min-width: 0; }}
  .ex > details, .ex > .head {{ grid-column: 1 / -1; }}
  .ex .head .who {{ margin: 0; }}
  .ex h2 {{ margin: 0 0 2px; font-size: 24px; letter-spacing: -.015em; }}
  .ex .who {{ margin: 0 0 14px; color: var(--accent); font-size: 14px; font-weight: 600; }}
  .does {{ list-style: none; padding: 0; margin: 0 0 14px; display: grid; gap: 8px; }}
  .does li {{ display: grid; grid-template-columns: 165px 1fr; gap: 12px; align-items: baseline; font-size: 15px; }}
  .does .k {{ font: 600 13px ui-monospace, Menlo, monospace; background: var(--surface-2); border: 1px solid var(--line); border-radius: 8px; padding: 3px 8px; justify-self: start; }}
  .change {{ margin: 0 0 14px; padding: 10px 14px; border-left: 3px solid var(--warn); background: color-mix(in srgb, var(--warn) 9%, transparent); border-radius: 0 10px 10px 0; font-size: 14.5px; }}
  .acts {{ display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 6px; }}
  .ex details {{ background: transparent; border: 0; padding: 0; margin: 0; }}
  .ex summary {{ font-weight: 500; color: var(--muted); padding: 8px 0; }}
  .ex pre {{ max-height: 420px; overflow: auto; margin: 4px 0 0; }}
  @media (max-width: 820px) {{ .ex {{ grid-template-columns: minmax(0, 1fr); }} .ex .art {{ max-width: 360px; }} .does li {{ grid-template-columns: 1fr; gap: 3px; }} }}
</style>
</head>
<body>
<nav>
  <div class="wrap">
    <a class="brand" href="index.html"><img src="assets/icon.png" alt="">MWM</a>
    <div class="links">
      <a href="index.html#top">Overview</a>
      <a href="features.html">Features</a>
      <a href="docs.html">Docs</a>
      <a href="examples.html" style="color:var(--fg)">Examples</a>
      <a href="changelog.html">Changelog</a>
      <a class="btn primary small cta" href="{DMG}">Download</a>
      <a class="gh" href="https://github.com/bbarbosa85/mwm" aria-label="MWM on GitHub" title="MWM on GitHub"><svg viewBox="0 0 16 16" width="22" height="22" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/></svg></a>
    </div>
  </div>
</nav>

<div class="docs-wrap">
<aside id="toc" aria-label="On this page">
  <div class="links-list">
  <h4>On this page</h4>
  <a href="#how">How to use</a>
  <h4>Examples</h4>
  {''.join(f'<a href="#{e[0].split(".")[0]}">{html.escape(e[1])}</a>' for e in examples)}
  </div>
</aside>
<main>
  <div class="intro-card">
    <h1 class="page"><span>Examples</span></h1>
    <p class="lead">Ready-made setups. Pick the one closest to how you work, download it, and change what you need. Each one lists what its shortcuts do.</p>
  </div>

  <div class="how" id="how">
    <h2>How to use an example</h2>
    <ol>
      <li><div><p><b>Download it</b> with the button on a card below.</p></div></li>
      <li><div><p><b>Add it as a profile.</b> Open <b>Settings</b>, choose <b>Manage profiles</b> at the bottom of the sidebar, then <b>Add profile</b>, <b>From a file</b>, and pick the file you downloaded. It's copied into <code>~/.mwm</code> next to your own profiles, so nothing you have is replaced.</p>
        <p class="sub">Or in Terminal (use the file name you downloaded):</p>
<pre><code>mkdir -p ~/.mwm
mv ~/Downloads/starter.mwm.yml ~/.mwm/starter.mwm.yaml</code></pre></div></li>
      <li><div><p><b>Use it.</b> Choose it from the profile button in the bottom bar of Settings (or <b>Use</b> on its card), or under <b>Profiles</b> in the menu bar, then press <b>Apply and Restart</b>. Then change the app and screen names to yours, right in the app.</p>
        <p class="sub">More help in the <a href="docs.html#profiles">documentation</a>.</p></div></li>
    </ol>
    <p style="margin:16px 0 0"><a class="btn small" href="examples/mwm-examples.zip" download>Download all {len(examples)} as a zip</a></p>
  </div>
  {''.join(card(*e) for e in examples)}
</main>
</div>

<script>
(function () {{
  document.addEventListener('click', function (e) {{
    var name = e.target.getAttribute && e.target.getAttribute('data-copy');
    if (!name) return;
    var text = document.getElementById('pre-' + name).textContent;
    if (navigator.clipboard) navigator.clipboard.writeText(text);
    var old = e.target.textContent; e.target.textContent = 'Copied'; setTimeout(function () {{ e.target.textContent = old; }}, 1200);
  }});
  var links = Array.prototype.slice.call(document.querySelectorAll('#toc a'));
  if ('IntersectionObserver' in window) {{
    var io = new IntersectionObserver(function (entries) {{
      entries.forEach(function (en) {{ if (en.isIntersecting) links.forEach(function (a) {{ a.classList.toggle('on', a.getAttribute('href') === '#' + en.target.id); }}); }});
    }}, {{ rootMargin: '-15% 0px -70% 0px' }});
    Array.prototype.forEach.call(document.querySelectorAll('.how, .ex'), function (el) {{ io.observe(el); }});
  }}
  if (location.hash) {{ var el = document.querySelector(location.hash); if (el) {{ var d = el.querySelector('details'); if (d) d.open = true; }} }}
}})();
</script>
</body>
</html>
"""
open(os.path.join(root, "examples.html"), "w", encoding="utf-8").write(page)
print("wrote docs/examples.html and docs/examples/mwm-examples.zip")
